BASE_URL=http://websocket.ramwin.com
BASE_WSS_URL=ws://websocket.ramwin.com

DEBUG=True
# 127.0.0.1 必须带上：AI 会议室插件的默认 busUrl 就是 http://127.0.0.1:7420，
# 少了它每个请求都会因 DisallowedHost 被 400 拒掉。
ALLOWED_HOSTS=websocket.ramwin.com;localhost;127.0.0.1

BASE_URL=http://websocket.ramwin.com:57419
BASE_WSS_URL=ws://websocket.ramwin.com:57419

# channel layer 后端：memory（默认，进程内广播，不需要 redis）/ redis（多实例共享广播，需要 redis 服务）
# 注意 .env 的优先级高于本文件
CHANNEL_LAYER_BACKEND=memory
